# Nebius Token Factory — OpenAI-compatible endpoint.
# Confirmed against Nebius's first-party docs (docs.tokenfactory.nebius.com):
#   cp .env.example .env   and fill in NEBIUS_API_KEY
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model picks (open-weight, hosted on Nebius Token Factory).
# Nemotron is preferred per the hackathon's sponsor-stack judging criterion.
THINK_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
AUDIT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# ASR: local faster-whisper (no key needed, reliable offline speech-to-text).
ASR_BACKEND=whisper_local
ASR_MODEL=base.en

# TTS: offline neural voice (Piper) preferred, with espeak-ng/System.Speech/pyttsx3
# as automatic fallbacks (ADR-008). No key, no network at runtime.
#   TTS_BACKEND=auto   -> use Piper when its CLI + model are present, else fall back
#   TTS_BACKEND=espeak -> force the legacy espeak-ng/System.Speech path
# TTS_PIPER_MODEL points at a local voice model; download it once with
# scripts/get_piper_voice.sh (model binaries are gitignored, never committed).
# If the model is missing, the demo still runs on the fallback voice.
TTS_BACKEND=auto
TTS_PIPER_MODEL=models/piper/en_US-ljspeech-medium.onnx
# TTS_PIPER_SERVER=1   # 0 = no warm Piper server process; one `piper` CLI call per sentence instead
# Upper bound in seconds on each synthesis tier per sentence (Piper, espeak,
# PowerShell, pyttsx3). A hung tier is killed/abandoned; a safety fast-path flag
# is still recorded. Non-numeric, non-finite or <= 0 falls back to 10.
TTS_TIMEOUT_S=10

# Web demo: how many senior turns (Send/Enter/proactive, any visitor) run at
# once. Turns within one session always run one at a time. Integer >= 2;
# anything else stops the app at startup with a clear error (ADR-003).
FY_TURN_CONCURRENCY=4

# Optional: one outbound caregiver notification per safety flag (ADR-014). OFF when
# FY_NOTIFY_CHANNEL is unset, and always off on a Hugging Face Space. The message carries
# only the fixed category text, severity, whether the senior was told, a household label
# and a time -- never the transcript. Choose smtp or webhook.
# FY_NOTIFY_CHANNEL=smtp
# FY_NOTIFY_TO=caregiver@example.com
# FY_NOTIFY_FROM=foreveryours@example.com
# FY_NOTIFY_SMTP_HOST=smtp.example.com
# FY_NOTIFY_SMTP_PORT=587
# FY_NOTIFY_SMTP_USER=
# FY_NOTIFY_SMTP_PASSWORD=
# FY_NOTIFY_SMTP_SECURITY=starttls   # starttls | ssl | none
# FY_NOTIFY_CHANNEL=webhook
# FY_NOTIFY_WEBHOOK_URL=http://localhost:8080/foreveryours
# FY_NOTIFY_HOUSEHOLD_LABEL=ForeverYours household
# FY_NOTIFY_MAX_PER_HOUR=6           # per household; over the cap the flag shows "notification failed"
