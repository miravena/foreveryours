# Nebius Token Factory — OpenAI-compatible endpoint.
# Confirmed against Nebius's own first-party docs (docs.tokenfactory.nebius.com):
#   cp .env.example .env   and fill in NEBIUS_API_KEY
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model picks (open-weight, hosted on Nebius Token Factory).
# Nemotron is preferred per the hackathon's sponsor-stack judging criterion.
# NOT YET VERIFIED against a live key -- treat this ID as a hypothesis to
# confirm with `GET /v1/models` on key-day, not a settled fact. If it isn't
# provisioned, fall back to a Llama model and say so in IMPLEMENTATION_PLAN.md.
THINK_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
AUDIT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ASR: prefer an NVIDIA ASR model (Parakeet/Canary) if Nebius hosts one on this account;
# otherwise falls back to local faster-whisper (no key needed, but not sponsor-stack).
ASR_BACKEND=whisper_local
ASR_MODEL=base.en
