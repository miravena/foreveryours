{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.key)",
      "Bash(cat *.env)",
      "Bash(cat **/.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(less *.env)",
      "Bash(grep * *.env)"
    ]
  }
}
