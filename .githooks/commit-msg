#!/bin/sh
# commit-msg: advisory checks on attribution. Always exits 0 so it never blocks a commit.
#   1. author email that GitHub cannot credit
#   2. an AI co-author trailer or vendor email (we use Assisted-by instead)
#   3. a session link in the message (the repo is public)
#   4. an Assisted-by line with no Cost-estimate line
# See CONTRIBUTING.md -> "Commit attribution" and "Recording what it cost"; ADR-007.

msgfile="$1"
email=$(git var GIT_AUTHOR_EMAIL 2>/dev/null || git config user.email)

case "$email" in
  *@users.noreply.github.com) ;;                              # linked by construction
  elevenbaselab@gmail.com|mathewgc007@gmail.com) ;;           # verified on a GitHub account
  *)
    cat >&2 <<MSG

WARNING: author email '$email' is not a known GitHub-linked address.
Commits with an unlinked author email do not appear under your account in the
Contributors graph (they credit nobody). Expected something ending in
@users.noreply.github.com — see CONTRIBUTING.md -> "Commit attribution".

MSG
    ;;
esac

[ -n "$msgfile" ] && [ -f "$msgfile" ] || exit 0
body=$(grep -v '^#' "$msgfile")

if printf '%s\n' "$body" | grep -qiE '^Co-Authored-By:.*(anthropic|claude|gemini|copilot|codex|openai|cursor)'; then
  printf '\nWARNING: AI Co-Authored-By trailer. Remove it and use `Assisted-by: <harness>:<model> effort=<level>`\n(CONTRIBUTING.md -> "Commit attribution", ADR-007).\n\n' >&2
fi
if printf '%s\n' "$body" | grep -qiE '^Claude-Session:|claude\.ai/code'; then
  printf '\nWARNING: session link in the commit message. This repo is public; remove it.\n\n' >&2
fi
if printf '%s\n' "$body" | grep -qE '^Assisted-by:' && ! printf '%s\n' "$body" | grep -qE '^Cost-estimate:'; then
  printf '\nWARNING: Assisted-by without Cost-estimate. Add `Cost-estimate: $X.XX (in N, out N tokens, approximate)`\nor `Cost-estimate: unknown` (CONTRIBUTING.md -> "Recording what it cost").\n\n' >&2
fi
exit 0
