#!/bin/sh
# commit-msg: advisory checks on attribution. Delegates to the shared checker
# (scripts/check_attribution.sh) so this hook and .github/workflows/attribution.yml
# run exactly the same checks -- see that script for the list. Always exits 0.
# See CONTRIBUTING.md -> "Commit attribution" and "Recording what it cost"; ADR-007.

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
"$hook_dir/../scripts/check_attribution.sh" "$1"
exit 0
